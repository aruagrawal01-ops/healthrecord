// Paste into https://dbdiagram.io to render the ER diagram (matches database/schema.sql)

Table departments { department_id serial [pk]  name varchar(100) [unique, not null] }

Table users {
  user_id serial [pk]
  username varchar(50) [unique, not null]
  email varchar(120) [unique, not null]
  password_hash varchar(255) [not null]
  role varchar(20) [not null, note: "patient | doctor | lab_assistant | admin"]
  is_active boolean [default: true]
  created_at timestamp
}

Table patients {
  patient_id serial [pk]
  user_id int [unique, not null, ref: - users.user_id]
  full_name varchar(100) [not null]
  dob date [not null]
  gender varchar(10)
  blood_group varchar(5)
  phone varchar(15)
  address text
  emergency_contact varchar(15)
}

Table doctors {
  doctor_id serial [pk]
  user_id int [unique, not null, ref: - users.user_id]
  full_name varchar(100) [not null]
  specialization varchar(100)
  qualification varchar(150)
  department_id int [ref: > departments.department_id]
  phone varchar(15)
}

Table lab_assistants {
  lab_assistant_id serial [pk]
  user_id int [unique, not null, ref: - users.user_id]
  full_name varchar(100) [not null]
  phone varchar(15)
}

Table admins {
  admin_id serial [pk]
  user_id int [unique, not null, ref: - users.user_id]
  full_name varchar(100) [not null]
}

Table appointments {
  appointment_id serial [pk]
  patient_id int [not null, ref: > patients.patient_id]
  doctor_id int [not null, ref: > doctors.doctor_id]
  appointment_date date [not null]
  appointment_time time [not null]
  reason varchar(255)
  status varchar(20) [default: 'Scheduled']
  created_at timestamp
}

Table medical_records {
  record_id serial [pk]
  patient_id int [not null, ref: > patients.patient_id]
  doctor_id int [not null, ref: > doctors.doctor_id]
  appointment_id int [ref: > appointments.appointment_id]
  diagnosis text [not null]
  prescription text
  notes text
  created_at timestamp
}

Table lab_tests {
  lab_test_id serial [pk]
  patient_id int [not null, ref: > patients.patient_id]
  doctor_id int [not null, ref: > doctors.doctor_id]
  test_name varchar(150) [not null]
  status varchar(20) [default: 'Pending']
  requested_at timestamp
}

Table lab_reports {
  report_id serial [pk]
  lab_test_id int [unique, not null, ref: - lab_tests.lab_test_id]
  lab_assistant_id int [not null, ref: > lab_assistants.lab_assistant_id]
  result_summary text [not null]
  file_name varchar(255)
  file_type varchar(100)
  file_data bytea
  uploaded_at timestamp
}
